{
  "name": "carprise",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Carprise mobility commerce platform — driver app + multi-role web platform",
  "scripts": {
    "start": "expo start",
    "driver": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "web:drive": "expo start --web",
    "export:web": "expo export -p web",
    "build": "expo export -p web && node scripts/nest-drive-dist.js",
    "typecheck": "tsc --noEmit",
    "platform": "npm --prefix platform run dev",
    "platform:3001": "npm --prefix platform run dev -- --port 3001",
    "platform:build": "npm --prefix platform run build",
    "platform:start": "npm --prefix platform run start",
    "dev:all": "echo Run 'npm start' for driver and 'npm run platform' for web in two terminals"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.6",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.4",
    "expo": "~57.0.7",
    "expo-blur": "^57.0.0",
    "expo-constants": "^57.0.0",
    "expo-dev-client": "~57.0.7",
    "expo-document-picker": "^57.0.0",
    "expo-haptics": "^57.0.0",
    "expo-image-picker": "^57.0.0",
    "expo-linear-gradient": "^57.0.0",
    "expo-linking": "^57.0.0",
    "expo-location": "~57.0.7",
    "expo-router": "^57.0.0",
    "expo-secure-store": "^57.0.0",
    "expo-status-bar": "^57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  }
}
